OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-5.4-mini
AI_DEVS_API_KEY=your-ai-devs-api-key-here
AI_DEVS_TASK_NAME=goingthere
AI_DEVS_HUB_ENDPOINT=hub_base_url

# Launch a CDP chrome session on port 9222 and authenticate to the hub before running time travel agent.
# example terminal command on macOS:
# /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome --remote-debugging-port=9222 --user-data-dir=/tmp/chrome_dev_session
