{
	"name": "@ai-devs/core",
	"version": "0.1.0",
	"author": "Dawid Dobrowolski",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "pnpm run compile:check && pnpm run lint:check && pnpm run format:fix && pnpm run test",
		"dev": "tsc --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"compile:check": "tsc --noEmit",
		"lint:check": "eslint .",
		"lint:fix": "eslint . --fix",
		"format:check": "prettier . --check",
		"format:fix": "prettier . --write"
	},
	"dependencies": {
		"@langfuse/otel": "^5.0.0",
		"@langfuse/tracing": "^5.0.0",
		"@opentelemetry/sdk-node": "^0.206.0",
		"axios": "^1.13.6",
		"dotenv": "^17.3.1",
		"openai": "^6.27.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^25.4.0",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.7.4",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.1",
		"vitest": "^4.1.2"
	}
}
